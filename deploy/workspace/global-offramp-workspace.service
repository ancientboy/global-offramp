[Unit]
Description=Huitu account beta and manual payout workspace (funds sandbox)
After=network.target docker.service
[Service]
Type=simple
User=offramp-workspace
Group=offramp-workspace
WorkingDirectory=/opt/global-offramp/business/current
EnvironmentFile=/etc/global-offramp/business/runtime.env
ExecStart=/opt/global-offramp/node/bin/node dist/apps/workspace/src/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
StateDirectory=global-offramp-workspace
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/global-offramp-workspace
MemoryMax=512M
[Install]
WantedBy=multi-user.target
