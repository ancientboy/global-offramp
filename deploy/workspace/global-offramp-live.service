[Unit]
Description=Huitu isolated live workspace (private staging; deposits disabled until acceptance)
After=network.target docker.service clamav-daemon.service
[Service]
Type=simple
User=offramp-workspace
Group=offramp-workspace
WorkingDirectory=/opt/global-offramp/business/current
EnvironmentFile=/etc/global-offramp/live/runtime.env
EnvironmentFile=/etc/global-offramp/business/nowpayments.env
ExecStart=/opt/global-offramp/node/bin/node dist/apps/workspace/src/main.js
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=global-offramp-live
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/global-offramp-live
MemoryMax=512M
[Install]
WantedBy=multi-user.target
