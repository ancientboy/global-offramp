# Private environment file: root owner, mode 0600. Never commit credentials.
WORKSPACE_ORIGIN=https://bhcbtc.club
WORKSPACE_PORT=4182
WORKSPACE_HOST=127.0.0.1
# Explicit development/testing capability: exact ledger credits only, no provider calls.
WORKSPACE_ENABLE_SIMULATED_TOPUPS=false
WORKSPACE_DATABASE_URL=postgresql://offramp_workspace_app:REPLACE_PRIVATELY@127.0.0.1:5432/offramp_workspace
WORKSPACE_RECEIPT_DIR=/var/lib/global-offramp-workspace/receipts
WORKSPACE_CLIENT_DIR=/opt/global-offramp/sites-dist/client
# Enable ONLY with a trusted loopback proxy overwriting X-Real-IP.
WORKSPACE_TRUST_LOOPBACK_PROXY=false
# For the existing Caddy container only: bind to 172.18.0.1 and trust its exact container IP.
# Caddy MUST overwrite X-Real-IP with its remote client address.
# WORKSPACE_TRUSTED_PROXY_IP=172.18.0.2
# Migration URL is for the one-off CLI ONLY; keep OUT of service environment.
# WORKSPACE_MIGRATION_DATABASE_URL=postgresql://migration-owner:REPLACE_PRIVATELY@127.0.0.1:5432/offramp_workspace

# Private 32-byte AES-256 key, retained across releases. Never commit the key.
WORKSPACE_RECIPIENT_KEY_FILE=/etc/global-offramp/recipient-vault.key

# An immutable database binding prevents reusing a sandbox ledger as a live ledger.
WORKSPACE_FUNDS_MODE=sandbox
WORKSPACE_SECURITY_KEY_FILE=/etc/global-offramp/account-security.key
# Real deposits require a NEW isolated live database, account security setup,
# merchant/network verification and a controlled end-to-end acceptance payment.
WORKSPACE_ENABLE_REAL_DEPOSITS=false
WORKSPACE_PAYOUTS_PAUSED=true
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_API_KEY=REPLACE_PRIVATELY
NOWPAYMENTS_IPN_SECRET=REPLACE_PRIVATELY
NOWPAYMENTS_NETWORKS=usdttrc20,usdcbase

WORKSPACE_RECEIPT_SCANNING=true

# Public treasury addresses owned by the operator, used ONLY to verify external transfers.
# These are NOT private keys. Do not guess addresses from customer deposits or accept them from a browser.
# Empty configuration keeps final transfer verification closed. Comma-separated when multiple.
WORKSPACE_TREASURY_USDTTRC20=
WORKSPACE_TREASURY_USDCBASE=

# Optional trusted HTTPS Base RPC endpoints, in priority order; all must report chainId 8453.
# Never accept a node URL from a browser. Credentials in URL paths remain private.
# WORKSPACE_BASE_RPC_URLS=https://YOUR_REVIEWED_RPC_ENDPOINT
